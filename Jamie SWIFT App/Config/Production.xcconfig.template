# Production Configuration Template
# Copy this file to Production.xcconfig and fill in your values

// API Keys
OPENAI_API_KEY = your_openai_api_key_here
OPENAI_ORG_ID = your_openai_org_id_here

// LiveKit Configuration
LIVEKIT_WS_URL = your_livekit_ws_url_here
LIVEKIT_API_KEY = your_livekit_api_key_here
LIVEKIT_API_SECRET = your_livekit_api_secret_here

// Development Team
DEVELOPMENT_TEAM = your_development_team_id_here

// Build Configuration
CONFIGURATION = Release
SWIFT_ACTIVE_COMPILATION_CONDITIONS = RELEASE

// Logging
ENABLE_DEBUG_LOGGING = 0
ENABLE_PERFORMANCE_LOGGING = 1

// Optimization
SWIFT_OPTIMIZATION_LEVEL = -O
GCC_OPTIMIZATION_LEVEL = 3

// Server Configuration
PORT = 3000
NODE_ENV = production

// Third-Party Services
PERPLEXITY_API_KEY = your_perplexity_api_key_here
ANTHROPIC_API_KEY = your_anthropic_api_key_here
DEEPGRAM_API_KEY = your_deepgram_api_key_here
MONGODB_URI = your_mongodb_uri_here

// Additional API Keys
// Add your API keys here, following the format:
// SERVICE_NAME_API_KEY = your_key_here

// Environment Variables for Build Settings
OTHER_SWIFT_FLAGS = $(inherited) -DRELEASE 