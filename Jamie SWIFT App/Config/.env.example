# Server Configuration
PORT=3000
NODE_ENV=development

# LiveKit Configuration (Required for video/audio)
LIVEKIT_API_KEY=your_key_here
LIVEKIT_API_SECRET=your_secret_here
LIVEKIT_WS_URL=your_ws_url_here

# OpenAI Configuration (Required for AI features)
OPENAI_API_KEY=your_key_here

# Perplexity Configuration (Required for AI Web Search)  
PERPLEXITY_API_KEY=your_key_here

# Anthropic Configuration (Required for AI computer use features)  
ANTHROPIC_API_KEY=your_key_here

# Deepgram Configuration (Required for real-time diarization AI transcription)
DEEPGRAM_API_KEY=your_key_here

# MongoDB Configuration
MONGODB_URI=your_mongodb_uri_here

# Logging
LOG_LEVEL=debug

# Client Configuration
REACT_APP_API_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:3000

# Core Data APIs
GOOGLE_CUSTOM_SEARCH_API_KEY=your_key_here  # https://developers.google.com/custom-search
ALPHA_VANTAGE_API_KEY=your_key_here  # https://www.alphavantage.co/support/#api-key
NEWSAPI_KEY=your_key_here  # https://newsapi.org/register
WIKIPEDIA_API_USER_AGENT="YourAppName (your_email@example.com)"  # No key needed, just identify yourself

# Kaggle Configuration
KAGGLE_USERNAME=your_username_here
KAGGLE_KEY=your_key_here

# Government Data
US_CENSUS_API_KEY=your_key_here  # https://api.census.gov/data/key_signup.html
DATA_GOV_API_KEY=your_key_here  # https://api.data.gov/signup/

# Academic/Research (Easy Registration)
CROSSREF_API_EMAIL=your_email  # No key needed, just email
SEMANTIC_SCHOLAR_API_KEY=your_key_here  # https://www.semanticscholar.org/product/api
PUBMED_API_KEY=your_key_here  # https://ncbiinsights.ncbi.nlm.nih.gov/2017/11/02/new-api-keys-for-the-e-utilities/

# Weather/Climate (Free Tiers)
OPENWEATHERMAP_API_KEY=your_key_here  # https://openweathermap.org/api
NOAA_API_TOKEN=your_key_here  # https://www.ncdc.noaa.gov/cdo-web/token

# Financial Data (Free Tiers)
FINANCIAL_MODELING_PREP_KEY=your_key_here  # https://financialmodelingprep.com/developer/docs/
COINBASE_API_KEY=your_key_here  # https://developers.coinbase.com/

# Geographic Data (Free Tiers)
MAPBOX_API_KEY=your_key_here  # https://account.mapbox.com/auth/signup/
OPENCAGE_API_KEY=your_key_here  # https://opencagedata.com/api

# Science/Research Data
NASA_API_KEY=your_key_here  # https://api.nasa.gov/
WORLDBANK_API_FORMAT=json  # No key needed, just specify format

# Academic Search & Citations
CORE_API_KEY=your_key_here  # https://core.ac.uk/services/api/ (Research papers)
UNPAYWALL_EMAIL=your_email  # https://unpaywall.org/products/api (Open access papers)
ARXIV_API_USER=your_app_name  # No key needed, just identify your app
LENS_API_KEY=your_key_here  # https://docs.api.lens.org/ (Patent & research data)

# Media & News
INTERNET_ARCHIVE_KEY=your_key_here  # https://archive.org/services/docs/api/
SPOTIFY_API_KEY=your_key_here  # For podcast metadata/transcripts
YOUTUBE_DATA_API_KEY=your_key_here  # For video metadata/transcripts
MEDIASTACK_API_KEY=your_key_here  # Real-time news API

# Visualization Tools
PLOTLY_API_KEY=your_key_here  # For dynamic chart generation
FLOURISH_API_KEY=your_key_here  # Data visualization
DATAWRAPPER_API_KEY=your_key_here  # Quick chart creation

# Fact Checking
GOOGLE_FACT_CHECK_API_KEY=your_key_here  # https://developers.google.com/fact-check/tools/api/
SNOPES_API_KEY=your_key_here  # Fact checking database

# Image Generation/Processing
STABILITY_API_KEY=your_key_here  # Stable Diffusion
CLOUDINARY_URL=your_url_here  # Image hosting/processing
IMGUR_CLIENT_ID=your_client_id  # Image hosting API

# Scientific Computing
WOLFRAM_ALPHA_APPID=your_key_here  # Computational knowledge engine
MATHPIX_API_KEY=your_key_here  # Math OCR and rendering

# Real-time Data
WEBSOCKET_HUB_KEY=your_key_here  # For real-time data streams
ABLY_API_KEY=your_key_here  # Real-time data infrastructure

# UI Generation Services
REPLICATE_API_TOKEN=your_key_here  # For UI component generation
VERCEL_AI_API_KEY=your_key_here  # For Vercel's AI components
STREAMLIT_SHARING_API_KEY=your_key_here  # If deploying to Streamlit Cloud
GRADIO_API_KEY=your_key_here  # For Gradio interfaces