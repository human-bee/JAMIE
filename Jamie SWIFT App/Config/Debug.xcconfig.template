# Debug Configuration Template
# Copy this file to Debug.xcconfig and fill in your values

// API Keys
OPENAI_API_KEY = your_openai_api_key_here
OPENAI_ORG_ID = your_openai_org_id_here

// LiveKit Configuration
LIVEKIT_WS_URL = your_livekit_ws_url_here
LIVEKIT_API_KEY = your_livekit_api_key_here
LIVEKIT_API_SECRET = your_livekit_api_secret_here

// Development Team
DEVELOPMENT_TEAM = your_development_team_id_here

// Build Configuration
CONFIGURATION = Debug
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG

// Logging
ENABLE_DEBUG_LOGGING = 1
ENABLE_PERFORMANCE_LOGGING = 1

// Development-specific settings
GCC_PREPROCESSOR_DEFINITIONS = DEBUG=1 $(inherited)
MTL_ENABLE_DEBUG_INFO = INCLUDE_SOURCE
ENABLE_TESTABILITY = YES
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ONLY_ACTIVE_ARCH = YES
GCC_OPTIMIZATION_LEVEL = 0
SWIFT_OPTIMIZATION_LEVEL = -Onone

// Enable additional debug logging
OTHER_SWIFT_FLAGS = $(inherited) -D DEBUG -D VERBOSE_LOGGING

// Development team and signing
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Mac Developer

// Enable additional debug features
ENABLE_NS_ASSERTIONS = YES 